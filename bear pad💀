      "to": [
        {
          "shell_command": "export LANG=en_US.UTF-8; old=\"$(pbpaste)\"; printf '←' | pbcopy; osascript -e 'tell application \"System Events\" to keystroke \"v\" using command down'; sleep 0.2; printf '%s' \"$old\" | pbcopy"
        }
      ]
    },

